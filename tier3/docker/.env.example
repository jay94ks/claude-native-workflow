# docker-compose.yml이 읽는 시크릿. 이 파일을 .env로 복사한 뒤 실제 값을
# 채운다(.env 자체는 커밋 대상이 아님 - 저장소 .gitignore 확인).
MYSQL_ROOT_PASSWORD=change-me
# backend가 실제로 붙는 최소 권한 계정(root가 아님) - MYSQL_DATABASE
# 하나에만 전체 권한을 갖고, mysql 인스턴스 전체는 못 건드린다.
MYSQL_APP_PASSWORD=change-me
# 최소 32자(무작위) 필요 - 짧으면 기동 자체가 실패한다. 예:
# `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
GITHUB_WEBHOOK_SECRET=change-me
