// claude-native-workflow v2 - PostgreSQL 스키마.
// 3개 드라이버(postgres/mysql/sqlite) 스키마는 datasource/generator
// output만 다르고 모델은 동일한 게 원칙이나, 딱 한 가지 예외: MySQL은
// 기본 String이 VARCHAR(191)로 매핑돼 긴 본문 텍스트가 잘린다 - 그
// 컬럼들만 schema.mysql.prisma에서 @db.LongText를 추가로 붙인다(다른
// 두 드라이버는 String 기본형 그대로 무제한 텍스트).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- 설치 전역

model InstallConfig {
  id            String  @id @default("singleton")
  teamsEnabled  Boolean @default(true)
}

// 추적 코드 중앙 레지스트리 - 원자적 insert로 발급을 예약한다(엔티티
// 테이블별 @unique만으로는 서로 다른 엔티티 타입 간 충돌을 못 막음 -
// 예: Document와 Question이 우연히 같은 문자열을 가질 수 있었음).
// **팀/프로젝트 경계를 넘지 않는다** - 코드 문자열의 유일성은 전역이
// 아니라 프로젝트 단위(`@@unique([projectId, code])`)라, 서로 다른
// 프로젝트는 같은 코드 문자열을 독립적으로 가질 수 있다(설계자 확인 -
// "각 팀과 프로젝트의 추적코드는 서로 별도"). teamId는
// Project→ProjectGroup을 거치지 않고 바로 경계를 확인할 수 있도록
// 복제해 저장(DocType/TemplateFile과 같은 스코프 패턴). which로 어떤
// 엔티티 타입인지, location으로 그 엔티티 자신의 내부 id를 가리킨다.
// 각 엔티티는 지금처럼 자기 테이블에도 trackingCode 컬럼을 그대로
// 유지한다(DocumentLink/Comment가 Document.trackingCode를 직접 가리키는
// 기존 FK 관계를 건드리지 않음 - 이 테이블은 발급/조회 전용 레지스트리).
model TrackingCode {
  id        String   @id @default(cuid())
  code      String // 추적 코드 문자열("XX-XXXXXXXX") - 프로젝트 안에서만 유일
  teamId    String?
  projectId String
  which     String // "document" | "question"
  location  String // 그 엔티티의 내부 id(Document.id / Question.id) - 발급 직후 잠깐 빈 문자열
  createdAt DateTime @default(now())

  team    Team?   @relation(fields: [teamId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, code])
  @@index([teamId])
  @@index([which])
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?  @unique
  phone         String?
  emailVisible  Boolean  @default(false)
  phoneVisible  Boolean  @default(false)
  passwordHash  String
  createdAt     DateTime @default(now())

  gitCredentials    GitCredential[]
  refreshTokens     RefreshToken[]
  memberships       Member[]
  documentsCreated  Document[]         @relation("DocumentCreatedBy")
  revisionsEdited   DocumentRevision[] @relation("RevisionEditedBy")
  questionsAsked    Question[]         @relation("QuestionAskedBy")
  answersGiven      Answer[]           @relation("AnswerAnsweredBy")
  comments          Comment[]          @relation("CommentAuthor")
  messagesSent      Message[]          @relation("MessageAuthor")
  teamAdminships    TeamAdmin[]
  accessOverrides   DocAccessOverride[]
  foldersCreated    Folder[]
  hiddenProjects    Project[]          @relation("ProjectHiddenBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// QA로 발견(concept 세션): hostPattern으로 재사용을 "제안"만 하고 실제
// 적용은 설계자 확인 후 - 자동으로 아무 프로젝트에나 재사용하지 않는다
// (자격증명 자동 유출 방지).
model GitCredential {
  id               String   @id @default(cuid())
  userId           String
  hostPattern      String?
  credentialType   String // token | username_password | ssh_key
  encryptedPayload Bytes // AES-256-GCM 암호문(+ nonce/태그 포함해서 저장)
  createdAt        DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  projectGitRepos ProjectGitRepo[]

  @@index([userId])
}

// ---------------------------------------------------------------- 계층: 팀/그룹/프로젝트

model Team {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  projectGroups ProjectGroup[]
  docTypes      DocType[]
  templateFiles TemplateFile[]
  trackingCodes TrackingCode[]
  admins        TeamAdmin[]
}

// 팀 관리자("팀장") - 팀 소속 프로젝트 그룹 하위 프로젝트가 숨김 처리돼도
// 계속 보고 해제할 수 있는 설계자(Project.hidden 참고). 팀 자체 쓰기가
// 지금까지 authenticate만 요구해온 것과 같은 인가 수준을 그대로 따른다
// (설치 단위 admin role 자체가 아직 없다는 기존 한계의 연장).
model TeamAdmin {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model ProjectGroup {
  id        String   @id @default(cuid())
  teamId    String?
  name      String
  createdAt DateTime @default(now())

  team          Team?          @relation(fields: [teamId], references: [id])
  projects      Project[]
  docTypes      DocType[]
  templateFiles TemplateFile[]

  @@index([teamId])
}

model Project {
  id             String   @id @default(cuid())
  projectGroupId String
  name           String
  hidden         Boolean  @default(false)
  hiddenBy       String?
  createdAt      DateTime @default(now())

  projectGroup    ProjectGroup     @relation(fields: [projectGroupId], references: [id])
  hiddenByUser    User?            @relation("ProjectHiddenBy", fields: [hiddenBy], references: [id])
  gitRepo         ProjectGitRepo?
  members         Member[]
  docTypes        DocType[]
  documents       Document[]
  comments        Comment[]
  pushHookPrompts PushHookPrompt[]
  messages        Message[]
  templateFiles   TemplateFile[]
  trackingCodes   TrackingCode[]
  folders         Folder[]
  accessOverrides DocAccessOverride[]

  @@index([projectGroupId])
}

model ProjectGitRepo {
  id                     String  @id @default(cuid())
  projectId              String  @unique
  provider               String // self_hosted | github | gitlab
  repoUrl                String
  externalRepoId         String?
  gitCredentialId        String?
  webhookSecretEncrypted Bytes? // AES-256-GCM - 수신 웹훅 서명/토큰 검증용

  project       Project        @relation(fields: [projectId], references: [id])
  gitCredential GitCredential? @relation(fields: [gitCredentialId], references: [id])

  @@index([gitCredentialId])
}

model Member {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // owner | editor | viewer
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- 문서 체계 (정규화된 타입/상태/전이)

model DocType {
  id             String   @id @default(cuid())
  teamId         String?
  projectGroupId String?
  projectId      String?
  code           String // 영문 2글자
  label          String
  guideline      String? // "이 타입은 무엇을 하기 위한 것인가" 자연어 설명(선택)
  createdAt      DateTime @default(now())

  team         Team?         @relation(fields: [teamId], references: [id])
  projectGroup ProjectGroup? @relation(fields: [projectGroupId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  statuses        DocStatus[]
  transitions     DocStatusTransition[]
  documents       Document[]
  accessOverrides DocAccessOverride[]

  @@index([teamId])
  @@index([projectGroupId])
  @@index([projectId])
}

model DocStatus {
  id         String  @id @default(cuid())
  docTypeId  String
  code       String
  label      String
  guideline  String? // 표준 상태 코드(draft/review/pending/approved/deprecated/archived)의 고정 의미 - core/docTypes.ts의 STANDARD_DOC_STATUSES에서 그대로 채워짐, 관리자가 수정 불가
  isTerminal Boolean @default(false)

  docType         DocType               @relation(fields: [docTypeId], references: [id])
  documents       Document[]
  transitionsFrom DocStatusTransition[] @relation("TransitionFrom")
  transitionsTo   DocStatusTransition[] @relation("TransitionTo")

  @@unique([docTypeId, code])
}

model DocStatusTransition {
  id           String  @id @default(cuid())
  docTypeId    String
  fromStatusId String
  toStatusId   String
  label        String?

  docType    DocType   @relation(fields: [docTypeId], references: [id])
  fromStatus DocStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id])
  toStatus   DocStatus @relation("TransitionTo", fields: [toStatusId], references: [id])

  @@index([docTypeId])
}

// ---------------------------------------------------------------- 문서/링크/버전이력

model Document {
  id           String   @id @default(cuid())
  projectId    String
  docTypeId    String
  folderId     String? // DB 전용 정리용 폴더(Folder) - null이면 최상단, AI(CLI/MCP)는 이 개념을 모름
  trackingCode String   @unique // "XX-XXXXXXXX"
  title        String
  body         String
  statusId     String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id])
  docType DocType   @relation(fields: [docTypeId], references: [id])
  folder  Folder?   @relation(fields: [folderId], references: [id])
  status  DocStatus @relation(fields: [statusId], references: [id])
  creator User      @relation("DocumentCreatedBy", fields: [createdBy], references: [id])

  revisions          DocumentRevision[]
  linksOut           DocumentLink[]       @relation("DocumentLinkSource")
  linksIn            DocumentLink[]       @relation("DocumentLinkTarget")
  questions          Question[]
  questionReferences QuestionReference[]
  comments           Comment[]            @relation("DocumentComments")
  accessOverrides    DocAccessOverride[]

  @@index([projectId])
  @@index([docTypeId])
  @@index([statusId])
  @@index([folderId])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  body       String
  editedBy   String
  editedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User     @relation("RevisionEditedBy", fields: [editedBy], references: [id])

  @@index([documentId])
}

// toTrackingCode를 Document.trackingCode로 향한 실제 FK로 걸어서
// (문자열 느슨한 매칭이 아니라) 역참조 join이 자연스럽게 되게 한다.
model DocumentLink {
  id             String  @id @default(cuid())
  fromDocumentId String
  toTrackingCode String
  linkType       String?

  fromDocument Document @relation("DocumentLinkSource", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument   Document @relation("DocumentLinkTarget", fields: [toTrackingCode], references: [trackingCode], onDelete: Cascade)

  @@index([fromDocumentId])
  @@index([toTrackingCode])
}

// ---------------------------------------------------------------- 질의/답변 (Question/Answer)

model Question {
  id           String   @id @default(cuid())
  documentId   String
  trackingCode String   @unique // "QU-XXXXXXXX"
  ordinal      Int
  text         String
  askedBy      String
  status       String   @default("open") // open(AI 질의, 설계자 답변 대기) | pending(설계자 답변 완료, AI 확인 대기) | resolved(AI 확인 완료)
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asker    User     @relation("QuestionAskedBy", fields: [askedBy], references: [id])
  answer   Answer?
  refs     QuestionReference[]

  @@index([documentId])
}

// AI가 질의를 등록할 때 판단에 참고한 문서들을 구조적으로 태깅(DocumentLink와
// 같은 조인 테이블 패턴 - 본문 텍스트에 욱여넣지 않는다).
model QuestionReference {
  id           String   @id @default(cuid())
  questionId   String
  trackingCode String
  createdAt    DateTime @default(now())

  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  referencedDocument Document @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([questionId, trackingCode])
  @@index([trackingCode])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String   @unique
  body       String
  answeredBy String
  answeredAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  author   User     @relation("AnswerAnsweredBy", fields: [answeredBy], references: [id])
}

// ---------------------------------------------------------------- 코멘트

model Comment {
  id           String    @id @default(cuid())
  projectId    String
  trackingCode String
  body         String
  authorId     String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  project  Project  @relation(fields: [projectId], references: [id])
  document Document @relation("DocumentComments", fields: [trackingCode], references: [trackingCode], onDelete: Cascade)
  author   User     @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@index([trackingCode])
}

// ---------------------------------------------------------------- git push 훅 프롬프트 자동화

model PushHookPrompt {
  id             String  @id @default(cuid())
  projectId      String
  triggerBranch  String?
  promptTemplate String
  createdAt      DateTime @default(now())

  project     Project              @relation(fields: [projectId], references: [id])
  queueEntries PushHookQueueEntry[]

  @@index([projectId])
}

model PushHookQueueEntry {
  id               String   @id @default(cuid())
  pushHookPromptId String
  commitSha        String
  status           String   @default("pending") // pending | acknowledged | done
  triggeredAt      DateTime @default(now())

  // 프롬프트 설정이 삭제되면 그 프롬프트가 쌓은 큐 항목도 같이 정리한다
  // (큐 항목은 프롬프트의 promptTemplate/triggerBranch를 join으로
  // 참고하므로, 프롬프트가 사라지면 맥락 없는 고아 레코드가 된다 -
  // deletePushHookPrompt()가 FK 위반 없이 항상 삭제되게 하는 실질적
  // 이유이기도 함, 실제 테스트에서 FK violation을 직접 겪고 수정함).
  pushHookPrompt PushHookPrompt @relation(fields: [pushHookPromptId], references: [id], onDelete: Cascade)

  @@index([pushHookPromptId])
}

// ---------------------------------------------------------------- 인스턴스 메시징

model Message {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String? // null이면 시스템 브로드캐스트
  body        String
  deliveredAt DateTime? // null="대기"(AI가 아직 안 읽음), 값 있으면 "기록"(CLI/MCP가 읽어감)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])
  author  User?   @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------- 템플릿 파일 (CLAUDE.md, SKILL.md 등)
// teamId/projectGroupId/projectId 중 정확히 하나만 채워지는 스코프
// 오버라이드, 셋 다 null이면 설치 전역 기본값. DocType과 같은 스코프
// 패턴 - filename별로 별도 테이블을 늘리지 않고 하나로 일반화.

model TemplateFile {
  id             String   @id @default(cuid())
  teamId         String?
  projectGroupId String?
  projectId      String?
  filename       String // 예: "CLAUDE.md", ".claude/skills/claude-native-workflow/SKILL.md"
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team         Team?         @relation(fields: [teamId], references: [id])
  projectGroup ProjectGroup? @relation(fields: [projectGroupId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  @@unique([teamId, projectGroupId, projectId, filename])
  @@index([teamId])
  @@index([projectGroupId])
  @@index([projectId])
}

// ---------------------------------------------------------------- 문서 정리용 폴더 (DB 전용, AI는 모름)
// 실제 git 파일 트리와 무관하게 설계자의 문서 정리 편의만을 위해 존재.
// CLI/MCP엔 이 모델 관련 명령/도구가 전혀 없고, 문서 조회 공용 라우트
// 응답에도 folderId 외 정보를 얹지 않는다 - 웹 UI 전용 라우트로만 접근.
model Folder {
  id             String   @id @default(cuid())
  projectId      String
  parentFolderId String?
  name           String
  createdBy      String
  createdAt      DateTime @default(now())

  project         Project             @relation(fields: [projectId], references: [id])
  parentFolder    Folder?             @relation("FolderChildren", fields: [parentFolderId], references: [id])
  childFolders    Folder[]            @relation("FolderChildren")
  documents       Document[]
  creator         User                @relation(fields: [createdBy], references: [id])
  accessOverrides DocAccessOverride[]

  // 같은 부모 아래 동명 폴더 금지는 parentFolderId가 nullable이라(여러
  // 드라이버가 NULL끼리는 유니크 위반으로 안 침) DB 제약이 아니라
  // core/folders.ts의 애플리케이션 레벨 findFirst 검사로 강제한다.
  @@index([projectId, parentFolderId])
}

// ---------------------------------------------------------------- 협업자별 세부 접근 권한
// project 공통 / docType 스코프 / document 스코프 / folder 스코프 중
// 정확히 하나만 채워짐(전부 null이면 "프로젝트 공통" 레벨) - 각 스코프
// 값이 null인 필드는 "이 레벨에서 명시 안 함, 더 넓은 기본값을 따름".
// null-스코프 유니크 문제(TemplateFile과 동일 이유)로 DB @@unique 대신
// core/permissions.ts가 findFirst 후 update/create.
model DocAccessOverride {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  docTypeId  String?
  documentId String?
  folderId   String?
  canRead    Boolean?
  canWrite   Boolean?
  canDelete  Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  docType  DocType? @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([docTypeId])
  @@index([documentId])
  @@index([folderId])
}
