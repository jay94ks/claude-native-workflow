// claude-native-workflow v2 - PostgreSQL 스키마.
// 3개 드라이버(postgres/mysql/sqlite) 스키마는 datasource/generator
// output만 다르고 모델은 동일한 게 원칙이나, 딱 한 가지 예외: MySQL은
// 기본 String이 VARCHAR(191)로 매핑돼 긴 본문 텍스트가 잘린다 - 그
// 컬럼들만 schema.mysql.prisma에서 @db.LongText를 추가로 붙인다(다른
// 두 드라이버는 String 기본형 그대로 무제한 텍스트).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- 설치 전역

model InstallConfig {
  id                                String  @id @default("singleton")
  teamsEnabled                      Boolean @default(true)
  giteaSystemWebhookSecretEncrypted Bytes?
}

// 추적 코드 중앙 레지스트리 - 원자적 insert로 발급을 예약한다(엔티티
// 테이블별 @unique만으로는 서로 다른 엔티티 타입 간 충돌을 못 막음 -
// 예: Document와 Question이 우연히 같은 문자열을 가질 수 있었음).
// **팀/프로젝트 경계를 넘지 않는다** - 코드 문자열의 유일성은 전역이
// 아니라 프로젝트 단위(`@@unique([projectId, code])`)라, 서로 다른
// 프로젝트는 같은 코드 문자열을 독립적으로 가질 수 있다(설계자 확인 -
// "각 팀과 프로젝트의 추적코드는 서로 별도"). teamId는
// Project→ProjectGroup을 거치지 않고 바로 경계를 확인할 수 있도록
// 복제해 저장(DocType/TemplateFile과 같은 스코프 패턴). which로 어떤
// 엔티티 타입인지, location으로 그 엔티티 자신의 내부 id를 가리킨다.
// 각 엔티티는 지금처럼 자기 테이블에도 trackingCode 컬럼을 그대로
// 유지한다(DocumentLink/Comment가 Document.trackingCode를 직접 가리키는
// 기존 FK 관계를 건드리지 않음 - 이 테이블은 발급/조회 전용 레지스트리).
model TrackingCode {
  id        String   @id @default(cuid())
  code      String // 추적 코드 문자열("XX-XXXXXXXX") - 프로젝트 안에서만 유일
  teamId    String?
  projectId String
  which     String // "document" | "question"
  location  String // 그 엔티티의 내부 id(Document.id / Question.id) - 발급 직후 잠깐 빈 문자열
  createdAt DateTime @default(now())

  team    Team?   @relation(fields: [teamId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, code])
  @@index([teamId])
  @@index([which])
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String?   @unique
  phone             String?
  emailVisible      Boolean   @default(false)
  phoneVisible      Boolean   @default(false)
  // 닉네임은 중복 가능 - 구분을 위해 "같은 닉네임 문자열(또는 미설정 시
  // 리터럴 '설계자') 풀 안에서의 순번"을 nicknameNumber에 확정해 저장한다
  // (매번 다시 세지 않고, 닉네임이 바뀌는 시점에만 재계산 - core/auth.ts의
  // nextNicknameNumber() 참고). nicknameChangedAt은 7일 변경 쿨다운 기준.
  nickname          String?
  nicknameNumber    Int       @default(1)
  nicknameChangedAt DateTime?
  passwordHash      String
  createdAt         DateTime  @default(now())
  // Gitea 사용자 계정 마스터링 - 가입 시 이 시스템이 대신 만드는 Gitea
  // 계정 정보. 비밀번호는 사람이 정하지 않고 시스템이 토큰처럼 발급·
  // 보관한다(core/giteaAccounts.ts 참고). 항상 존재해야 하는 1:1 관계라
  // 별도 테이블 대신 User에 직접 둔다.
  giteaUsername      String?   @unique
  giteaPasswordEncrypted Bytes?
  giteaUserId        Int?
  giteaProvisionedAt DateTime?
  // 계정 생성 직후 그 임시 비밀번호로 발급해두는 Gitea PAT - 백엔드가
  // 이 설계자를 대신해 커밋할 때(core/gitea.ts의 putFileContent)와
  // 이 설계자가 외부 git 클라이언트에서 직접 쓰는 자격증명을 겸한다
  // (core/giteaAccounts.ts 참고).
  giteaAccessTokenEncrypted Bytes?
  giteaTokenName            String?

  gitCredentials    GitCredential[]
  refreshTokens     RefreshToken[]
  memberships       Member[]
  documentsCreated  Document[]         @relation("DocumentCreatedBy")
  revisionsEdited   DocumentRevision[] @relation("RevisionEditedBy")
  questionsAsked    Question[]         @relation("QuestionAskedBy")
  answersGiven      Answer[]           @relation("AnswerAnsweredBy")
  comments          Comment[]          @relation("CommentAuthor")
  messagesSent      Message[]          @relation("MessageAuthor")
  teamAdminships    TeamAdmin[]
  accessOverrides   DocAccessOverride[]
  foldersCreated    Folder[]
  folderEntries     DocumentFolderEntry[]
  sourceLinksAdded  DocumentSourceLink[]
  hiddenProjects    Project[]          @relation("ProjectHiddenBy")
  apiKeysOwned      ApiKey[]           @relation("ApiKeyOwner")
  apiKeysRevoked    ApiKey[]           @relation("ApiKeyRevoker")
  kanbanColumnPrefs KanbanColumnPref[]
  kanbanCardsCreated KanbanCard[]        @relation("KanbanCardCreatedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// QA로 발견(concept 세션): hostPattern으로 재사용을 "제안"만 하고 실제
// 적용은 설계자 확인 후 - 자동으로 아무 프로젝트에나 재사용하지 않는다
// (자격증명 자동 유출 방지).
model GitCredential {
  id               String   @id @default(cuid())
  userId           String
  hostPattern      String?
  credentialType   String // token | username_password | ssh_key
  encryptedPayload Bytes // AES-256-GCM 암호문(+ nonce/태그 포함해서 저장)
  createdAt        DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  projectGitRepos ProjectGitRepo[]

  @@index([userId])
}

// ---------------------------------------------------------------- 계층: 팀/그룹/프로젝트

model Team {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  projectGroups ProjectGroup[]
  docTypes      DocType[]
  templateFiles TemplateFile[]
  trackingCodes TrackingCode[]
  admins        TeamAdmin[]
  apiKeys       ApiKey[]
}

// 팀 관리자("팀장") - 팀 소속 프로젝트 그룹 하위 프로젝트가 숨김 처리돼도
// 계속 보고 해제할 수 있는 설계자(Project.hidden 참고). 팀 자체 쓰기가
// 지금까지 authenticate만 요구해온 것과 같은 인가 수준을 그대로 따른다
// (설치 단위 admin role 자체가 아직 없다는 기존 한계의 연장).
model TeamAdmin {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model ProjectGroup {
  id        String   @id @default(cuid())
  teamId    String?
  name      String
  createdAt DateTime @default(now())

  team          Team?          @relation(fields: [teamId], references: [id])
  projects      Project[]
  docTypes      DocType[]
  templateFiles TemplateFile[]

  @@index([teamId])
}

model Project {
  id             String   @id @default(cuid())
  projectGroupId String
  name           String
  hidden         Boolean  @default(false)
  hiddenBy       String?
  createdAt      DateTime @default(now())

  projectGroup    ProjectGroup     @relation(fields: [projectGroupId], references: [id])
  hiddenByUser    User?            @relation("ProjectHiddenBy", fields: [hiddenBy], references: [id])
  gitRepo         ProjectGitRepo?
  members         Member[]
  docTypes        DocType[]
  documents       Document[]
  comments        Comment[]
  questions       Question[]
  pushHookPrompts PushHookPrompt[]
  messages        Message[]
  templateFiles   TemplateFile[]
  trackingCodes   TrackingCode[]
  folders         Folder[]
  accessOverrides DocAccessOverride[]
  apiKeys         ApiKey[]
  kanbanColumns   KanbanColumn[]
  kanbanCards     KanbanCard[]

  @@index([projectGroupId])
}

model ProjectGitRepo {
  id                     String  @id @default(cuid())
  projectId              String  @unique
  provider               String // self_hosted | github | gitlab
  repoUrl                String
  externalRepoId         String?
  gitCredentialId        String?
  webhookSecretEncrypted Bytes? // AES-256-GCM - 수신 웹훅 서명/토큰 검증용

  project       Project        @relation(fields: [projectId], references: [id])
  gitCredential GitCredential? @relation(fields: [gitCredentialId], references: [id])

  @@index([gitCredentialId])
}

model Member {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // owner | editor | viewer
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- 문서 체계 (정규화된 타입/상태/전이)

model DocType {
  id             String   @id @default(cuid())
  teamId         String?
  projectGroupId String?
  projectId      String?
  code           String // 영문 2글자
  label          String
  guideline      String? // "이 타입은 무엇을 하기 위한 것인가" 자연어 설명(선택)
  createdAt      DateTime @default(now())

  team         Team?         @relation(fields: [teamId], references: [id])
  projectGroup ProjectGroup? @relation(fields: [projectGroupId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  statuses        DocStatus[]
  transitions     DocStatusTransition[]
  documents       Document[]
  accessOverrides DocAccessOverride[]

  @@index([teamId])
  @@index([projectGroupId])
  @@index([projectId])
}

model DocStatus {
  id         String  @id @default(cuid())
  docTypeId  String
  code       String
  label      String
  guideline  String? // 표준 상태 코드(draft/review/pending/approved/deprecated/archived)의 고정 의미 - core/docTypes.ts의 STANDARD_DOC_STATUSES에서 그대로 채워짐, 관리자가 수정 불가
  isTerminal Boolean @default(false)

  docType         DocType               @relation(fields: [docTypeId], references: [id])
  documents       Document[]
  transitionsFrom DocStatusTransition[] @relation("TransitionFrom")
  transitionsTo   DocStatusTransition[] @relation("TransitionTo")

  @@unique([docTypeId, code])
}

model DocStatusTransition {
  id           String  @id @default(cuid())
  docTypeId    String
  fromStatusId String
  toStatusId   String
  label        String?

  docType    DocType   @relation(fields: [docTypeId], references: [id])
  fromStatus DocStatus @relation("TransitionFrom", fields: [fromStatusId], references: [id])
  toStatus   DocStatus @relation("TransitionTo", fields: [toStatusId], references: [id])

  @@index([docTypeId])
}

// ---------------------------------------------------------------- 문서/링크/버전이력

model Document {
  id           String   @id @default(cuid())
  projectId    String
  docTypeId    String
  trackingCode String   @unique // "XX-XXXXXXXX"
  title        String
  body         String
  statusId     String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id])
  docType DocType   @relation(fields: [docTypeId], references: [id])
  status  DocStatus @relation(fields: [statusId], references: [id])
  creator User      @relation("DocumentCreatedBy", fields: [createdBy], references: [id])

  revisions          DocumentRevision[]
  linksOut           DocumentLink[]       @relation("DocumentLinkSource")
  linksIn            DocumentLink[]       @relation("DocumentLinkTarget")
  questionReferences QuestionReference[]
  accessOverrides    DocAccessOverride[]
  folderEntries      DocumentFolderEntry[]
  sourceLinks        DocumentSourceLink[]
  kanbanCardRefs     KanbanCardDocumentRef[]

  @@index([projectId])
  @@index([docTypeId])
  @@index([statusId])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  body       String
  editedBy   String
  editedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User     @relation("RevisionEditedBy", fields: [editedBy], references: [id])

  @@index([documentId])
}

// toTrackingCode를 Document.trackingCode로 향한 실제 FK로 걸어서
// (문자열 느슨한 매칭이 아니라) 역참조 join이 자연스럽게 되게 한다.
model DocumentLink {
  id             String  @id @default(cuid())
  fromDocumentId String
  toTrackingCode String
  linkType       String?

  fromDocument Document @relation("DocumentLinkSource", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument   Document @relation("DocumentLinkTarget", fields: [toTrackingCode], references: [trackingCode], onDelete: Cascade)

  @@index([fromDocumentId])
  @@index([toTrackingCode])
}

// ---------------------------------------------------------------- 질의/답변 (Question/Answer)
// targetType/targetKey로 다형화 - document/kanbanCard면 그 자신의
// 트래킹 코드, source면 git 저장소 루트 기준 파일 경로. 폴리모픽이라
// 단일 FK로 못 묶는다(Prisma 근본 제약) - 대상이 지워질 때의 정리는
// 호출부(core/documents.ts의 deleteDocument())가 명시적으로 한다.
// kind로 "승인 요청"/"답변 요청"을 구분한다.
model Question {
  id           String   @id @default(cuid())
  projectId    String
  targetType   String   // "document" | "source" | "kanbanCard"
  targetKey    String
  trackingCode String   @unique // "QU-XXXXXXXX"
  ordinal      Int
  kind         String   // "approval" | "answer"
  text         String
  askedBy      String
  status       String   @default("open") // open(AI 질의, 설계자 답변 대기) | pending(설계자 답변 완료, AI 확인 대기) | resolved(AI 확인 완료)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  asker   User    @relation("QuestionAskedBy", fields: [askedBy], references: [id])
  answer  Answer?
  refs    QuestionReference[]
  options QuestionOption[]

  @@index([projectId])
  @@index([targetType, targetKey])
}

// AI가 질의를 등록할 때 판단에 참고한 문서들을 구조적으로 태깅(DocumentLink와
// 같은 조인 테이블 패턴 - 본문 텍스트에 욱여넣지 않는다).
model QuestionReference {
  id           String   @id @default(cuid())
  questionId   String
  trackingCode String
  createdAt    DateTime @default(now())

  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  referencedDocument Document @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([questionId, trackingCode])
  @@index([trackingCode])
}

// AI가 답변 요청 질문에 제안하는 선택지 - 클릭하면 라벨이 그대로
// 답변 수동 입력칸에 반영된다(제출은 별도 - 검토 후 확정 제출).
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  detail     String?
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// body는 kind="answer"일 때 필수(자유 텍스트 답변), kind="approval"일
// 때는 선택(승인/거부 버튼에 곁들이는 메모) - decision은 그 반대로
// approval일 때만 채워진다.
model Answer {
  id         String   @id @default(cuid())
  questionId String   @unique
  decision   String? // "approved" | "rejected" - kind="approval"일 때만
  body       String?
  answeredBy String
  answeredAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation("AnswerAnsweredBy", fields: [answeredBy], references: [id])
}

// ---------------------------------------------------------------- 코멘트
// Question과 같은 targetType/targetKey 다형화. 지난 라운드에서 편집/
// 삭제를 지원하려고 따로 만들었던 KanbanCardComment는 이제 이 모델이
// 편집/삭제를 직접 지원하면서 필요 없어져 흡수됐다(targetType:
// "kanbanCard").
model Comment {
  id         String    @id @default(cuid())
  projectId  String
  targetType String    // "document" | "source" | "kanbanCard"
  targetKey  String
  body       String
  authorId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  status     String    @default("open") // open | closed | solved | etc - 작성자 본인만 변경 가능

  project Project @relation(fields: [projectId], references: [id])
  author  User    @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@index([targetType, targetKey])
}

// ---------------------------------------------------------------- git push 훅 프롬프트 자동화

model PushHookPrompt {
  id             String  @id @default(cuid())
  projectId      String
  triggerBranch  String?
  promptTemplate String
  createdAt      DateTime @default(now())

  project     Project              @relation(fields: [projectId], references: [id])
  queueEntries PushHookQueueEntry[]

  @@index([projectId])
}

model PushHookQueueEntry {
  id               String   @id @default(cuid())
  pushHookPromptId String
  commitSha        String
  status           String   @default("pending") // pending | acknowledged | done
  triggeredAt      DateTime @default(now())

  // 프롬프트 설정이 삭제되면 그 프롬프트가 쌓은 큐 항목도 같이 정리한다
  // (큐 항목은 프롬프트의 promptTemplate/triggerBranch를 join으로
  // 참고하므로, 프롬프트가 사라지면 맥락 없는 고아 레코드가 된다 -
  // deletePushHookPrompt()가 FK 위반 없이 항상 삭제되게 하는 실질적
  // 이유이기도 함, 실제 테스트에서 FK violation을 직접 겪고 수정함).
  pushHookPrompt PushHookPrompt @relation(fields: [pushHookPromptId], references: [id], onDelete: Cascade)

  @@index([pushHookPromptId])
}

// ---------------------------------------------------------------- 인스턴스 메시징

model Message {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String? // null이면 시스템 브로드캐스트
  body        String
  deliveredAt DateTime? // null="대기"(AI가 아직 안 읽음), 값 있으면 "기록"(CLI/MCP가 읽어감)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])
  author  User?   @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------- 템플릿 파일 (CLAUDE.md, SKILL.md 등)
// teamId/projectGroupId/projectId 중 정확히 하나만 채워지는 스코프
// 오버라이드, 셋 다 null이면 설치 전역 기본값. DocType과 같은 스코프
// 패턴 - filename별로 별도 테이블을 늘리지 않고 하나로 일반화.

model TemplateFile {
  id             String   @id @default(cuid())
  teamId         String?
  projectGroupId String?
  projectId      String?
  filename       String // 예: "CLAUDE.md", ".claude/skills/claude-native-workflow/SKILL.md"
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team         Team?         @relation(fields: [teamId], references: [id])
  projectGroup ProjectGroup? @relation(fields: [projectGroupId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])

  @@unique([teamId, projectGroupId, projectId, filename])
  @@index([teamId])
  @@index([projectGroupId])
  @@index([projectId])
}

// ---------------------------------------------------------------- 문서 정리용 폴더 (DB 전용, AI는 모름)
// 설계자 개인 소유 - createdBy가 곧 소유자다(다른 설계자는 이 폴더의
// 존재 자체를 조회할 수 없음, core/folders.ts가 항상 projectId+createdBy로
// 필터). order는 같은 부모+소유자 형제 사이의 표시 순서(생성 시 끝에 추가).
// CLI/MCP엔 이 모델 관련 명령/도구가 전혀 없고, 문서 조회 공용 라우트
// 응답에도 폴더 정보를 얹지 않는다 - 웹 UI 전용 라우트로만 접근.
model Folder {
  id             String   @id @default(cuid())
  projectId      String
  parentFolderId String?
  name           String
  order          Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())

  project      Project              @relation(fields: [projectId], references: [id])
  parentFolder Folder?              @relation("FolderChildren", fields: [parentFolderId], references: [id])
  childFolders Folder[]             @relation("FolderChildren")
  creator      User                 @relation(fields: [createdBy], references: [id])
  entries      DocumentFolderEntry[]

  // 같은 부모+소유자 아래 동명 폴더 금지는 parentFolderId가 nullable이라
  // (여러 드라이버가 NULL끼리는 유니크 위반으로 안 침) DB 제약이 아니라
  // core/folders.ts의 애플리케이션 레벨 findFirst 검사로 강제한다.
  @@index([projectId, parentFolderId])
}

// 문서 하나를 여러 설계자가 각자 자신의 개인 폴더에 서로 다르게(혹은
// 아무 폴더에도 안) 배치할 수 있어야 해서, Document.folderId 단일
// 컬럼 대신 (document, user)당 최대 한 행인 조인 테이블로 배치를
// 표현한다 - 행이 없으면 그 설계자에게는 "미분류".
model DocumentFolderEntry {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  folderId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([folderId])
  @@index([userId])
}

// 문서 ↔ "연관된 소스코드" 파일 경로 - git 저장소 루트 기준 상대 경로
// 문자열만 저장한다(그 경로가 실제로 존재하는지는 검증하지 않음 -
// 순수 연관 관계, CLI/MCP에도 노출되는 AI 가시 기능).
model DocumentSourceLink {
  id         String   @id @default(cuid())
  documentId String
  filePath   String
  createdBy  String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, filePath])
  @@index([documentId])
}

// ---------------------------------------------------------------- 협업자별 세부 접근 권한
// project 공통 / docType 스코프 / document 스코프 중 정확히 하나만
// 채워짐(전부 null이면 "프로젝트 공통" 레벨) - 각 스코프 값이 null인
// 필드는 "이 레벨에서 명시 안 함, 더 넓은 기본값을 따름". null-스코프
// 유니크 문제(TemplateFile과 동일 이유)로 DB @@unique 대신
// core/permissions.ts가 findFirst 후 update/create. (폴더 스코프
// 오버라이드는 폐기됨 - 폴더가 항상 개인 소유라 다른 설계자의 폴더
// 쓰기를 제한한다는 개념 자체가 더 이상 성립하지 않음.)
model DocAccessOverride {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  docTypeId  String?
  documentId String?
  canRead    Boolean?
  canWrite   Boolean?
  canDelete  Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  docType  DocType?  @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([docTypeId])
  @@index([documentId])
}

// ---------------------------------------------------------------- API 키(신원 위임 인증)
// scope="personal"이면 projectId/teamId 둘 다 null(그 설계자가 접근
// 가능한 모든 프로젝트), "project"면 projectId만, "team"이면 teamId만
// 채워진다 - 셋 다 ownerId가 대행하는 신원이고, 스코프만 다르다.
// 원문(secret)은 저장하지 않는다(keyHash만) - "생성 시 1회만 노출,
// 이후엔 본인도 마스킹"을 구조적으로 강제하기 위함.
model ApiKey {
  id         String    @id @default(cuid())
  ownerId    String
  scope      String // personal | project | team
  projectId  String?
  teamId     String?
  label      String?
  keyPrefix  String
  keyHash    String    @unique
  status     String    @default("active") // active | revoked
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?

  owner   User     @relation("ApiKeyOwner", fields: [ownerId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  revoker User?    @relation("ApiKeyRevoker", fields: [revokedBy], references: [id])

  @@index([ownerId])
  @@index([projectId])
  @@index([teamId])
}

// ---------------------------------------------------------------- 칸반 보드
// 컬럼(분류)은 프로젝트 공유 자원 - 순서/숨김만 설계자별로 다르게 볼 수
// 있다(KanbanColumnPref, null 필드는 "이 설계자가 커스텀 안 함 → 컬럼
// 자체의 기본값을 따름" - TemplateFile류와 같은 오버레이 패턴).
model KanbanColumn {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project            @relation(fields: [projectId], references: [id])
  prefs   KanbanColumnPref[]
  cards   KanbanCard[]

  @@index([projectId])
}

model KanbanColumnPref {
  id       String   @id @default(cuid())
  columnId String
  userId   String
  order    Int?
  hidden   Boolean?

  column KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@unique([columnId, userId])
  @@index([userId])
}

// 카드는 문서/질문과 같은 원칙으로 트래킹 코드를 받는다("KB-XXXXXXXX").
// origin("ai"|"designer")으로 누가 만들었는지 구분 - 설계자가 만든
// 카드는 항상 "반드시 진행되어야 하는 작업"으로 간주된다(별도
// mandatory 컬럼 없이 origin이 그 의미를 겸함). hidden은 컬럼과 달리
// 설계자별이 아니라 전역(공유 보드의 실제 작업 항목이므로).
model KanbanCard {
  id           String   @id @default(cuid())
  projectId    String
  columnId     String
  trackingCode String   @unique // "KB-XXXXXXXX"
  title        String
  body         String?
  origin       String   // "ai" | "designer"
  hidden       Boolean  @default(false)
  order        Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project                 @relation(fields: [projectId], references: [id])
  column   KanbanColumn            @relation(fields: [columnId], references: [id])
  creator  User                    @relation("KanbanCardCreatedBy", fields: [createdBy], references: [id])
  docRefs  KanbanCardDocumentRef[]

  @@index([projectId])
  @@index([columnId])
}

// 카드가 근거로 삼은 문서들 - QuestionReference와 동일한 조인 테이블
// 패턴(카드 다이얼로그의 "근거 문서" 목록).
model KanbanCardDocumentRef {
  id           String @id @default(cuid())
  cardId       String
  trackingCode String

  card     KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  document Document   @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([cardId, trackingCode])
  @@index([trackingCode])
}

// 카드별 코멘트는 더 이상 별도 모델이 아니다 - 공용 Comment
// (targetType:"kanbanCard", targetKey=카드의 트래킹 코드)로 흡수됨.
