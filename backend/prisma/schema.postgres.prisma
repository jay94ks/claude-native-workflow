// claude-native-workflow v2 - PostgreSQL 스키마.
// 3개 드라이버(postgres/mysql/sqlite) 스키마는 datasource/generator
// output만 다르고 모델은 동일한 게 원칙이나, 딱 한 가지 예외: MySQL은
// 기본 String이 VARCHAR(191)로 매핑돼 긴 본문 텍스트가 잘린다 - 그
// 컬럼들만 schema.mysql.prisma에서 @db.LongText를 추가로 붙인다(다른
// 두 드라이버는 String 기본형 그대로 무제한 텍스트).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- 설치 전역

model InstallConfig {
  id                                String  @id @default("singleton")
  teamsEnabled                      Boolean @default(true)
  giteaSystemWebhookSecretEncrypted Bytes?
}

// 추적 코드 중앙 레지스트리 - 원자적 insert로 발급을 예약한다(엔티티
// 테이블별 @unique만으로는 서로 다른 엔티티 타입 간 충돌을 못 막음 -
// 예: Document와 Question이 우연히 같은 문자열을 가질 수 있었음).
// **팀/프로젝트 경계를 넘지 않는다** - 코드 문자열의 유일성은 전역이
// 아니라 프로젝트 단위(`@@unique([projectId, code])`)라, 서로 다른
// 프로젝트는 같은 코드 문자열을 독립적으로 가질 수 있다(설계자 확인 -
// "각 팀과 프로젝트의 추적코드는 서로 별도"). teamId는
// Project→ProjectGroup을 거치지 않고 바로 경계를 확인할 수 있도록
// 복제해 저장(DocType/TemplateFile과 같은 스코프 패턴). which로 어떤
// 엔티티 타입인지, location으로 그 엔티티 자신의 내부 id를 가리킨다.
// 각 엔티티는 지금처럼 자기 테이블에도 trackingCode 컬럼을 그대로
// 유지한다(DocumentLink/Comment가 Document.trackingCode를 직접 가리키는
// 기존 FK 관계를 건드리지 않음 - 이 테이블은 발급/조회 전용 레지스트리).
model TrackingCode {
  id        String   @id @default(cuid())
  code      String // 추적 코드 문자열("XX-XXXXXXXX") - 프로젝트 안에서만 유일
  teamId    String?
  projectId String
  which     String // "document" | "question"
  location  String // 그 엔티티의 내부 id(Document.id / Question.id) - 발급 직후 잠깐 빈 문자열
  createdAt DateTime @default(now())

  team    Team?   @relation(fields: [teamId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@index([teamId])
  @@index([which])
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String?   @unique
  phone             String?
  emailVisible      Boolean   @default(false)
  phoneVisible      Boolean   @default(false)
  // 닉네임은 중복 가능 - 구분을 위해 "같은 닉네임 문자열(또는 미설정 시
  // 리터럴 '설계자') 풀 안에서의 순번"을 nicknameNumber에 확정해 저장한다
  // (매번 다시 세지 않고, 닉네임이 바뀌는 시점에만 재계산 - core/auth.ts의
  // nextNicknameNumber() 참고). nicknameChangedAt은 7일 변경 쿨다운 기준.
  nickname          String?
  nicknameNumber    Int       @default(1)
  nicknameChangedAt DateTime?
  passwordHash      String
  createdAt         DateTime  @default(now())
  // Gitea 사용자 계정 마스터링 - 가입 시 이 시스템이 대신 만드는 Gitea
  // 계정 정보. 비밀번호는 사람이 정하지 않고 시스템이 토큰처럼 발급·
  // 보관한다(core/giteaAccounts.ts 참고). 항상 존재해야 하는 1:1 관계라
  // 별도 테이블 대신 User에 직접 둔다.
  giteaUsername      String?   @unique
  giteaPasswordEncrypted Bytes?
  giteaUserId        Int?
  giteaProvisionedAt DateTime?
  // 계정 생성 직후 그 임시 비밀번호로 발급해두는 Gitea PAT - 백엔드가
  // 이 설계자를 대신해 커밋할 때(core/gitea.ts의 putFileContent)와
  // 이 설계자가 외부 git 클라이언트에서 직접 쓰는 자격증명을 겸한다
  // (core/giteaAccounts.ts 참고).
  giteaAccessTokenEncrypted Bytes?
  giteaTokenName            String?
  // CLI/MCP가 message wait에서 EMQX에 직접 구독할 때 쓰는 전용 계정
  // 비밀번호 - JWT처럼 수명이 짧지 않고, REST 전체 권한이 아니라 MQTT
  // 접속에만 쓰이는 좁은 범위의 자격증명이다(설계자 지시 - message
  // wait을 백엔드가 대신 구독하지 않고 CLI/MCP가 직접 구독하도록 전환).
  // 첫 요청 시점에 지연 생성(giteaAccounts.ts와 같은 패턴 - 항상 1:1
  // 관계라 별도 테이블 대신 User에 직접 둠).
  mqttPasswordEncrypted Bytes?

  gitCredentials    GitCredential[]
  refreshTokens     RefreshToken[]
  memberships       Member[]
  documentsCreated  Document[]         @relation("DocumentCreatedBy")
  revisionsEdited   DocumentRevision[] @relation("RevisionEditedBy")
  templateRevisionsEdited TemplateRevision[] @relation("TemplateRevisionEditedBy")
  questionsAsked    Question[]         @relation("QuestionAskedBy")
  answersGiven      Answer[]           @relation("AnswerAnsweredBy")
  comments          Comment[]          @relation("CommentAuthor")
  messagesSent      Message[]          @relation("MessageAuthor")
  teamAdminships    TeamAdmin[]
  projectGroupAdminships ProjectGroupAdmin[]
  accessOverrides   DocAccessOverride[]
  foldersCreated    Folder[]
  folderEntries     DocumentFolderEntry[]
  sourceLinksAdded  DocumentSourceLink[]
  branchLinksAdded  DocumentBranchLink[]
  codeRelations     CodeRelation[]
  hiddenProjects    Project[]          @relation("ProjectHiddenBy")
  apiKeysOwned      ApiKey[]           @relation("ApiKeyOwner")
  apiKeysRevoked    ApiKey[]           @relation("ApiKeyRevoker")
  kanbanColumnPrefs KanbanColumnPref[]
  kanbanCardsCreated KanbanCard[]        @relation("KanbanCardCreatedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// QA로 발견(concept 세션): hostPattern으로 재사용을 "제안"만 하고 실제
// 적용은 설계자 확인 후 - 자동으로 아무 프로젝트에나 재사용하지 않는다
// (자격증명 자동 유출 방지).
model GitCredential {
  id               String   @id @default(cuid())
  userId           String
  hostPattern      String?
  credentialType   String // token | username_password | ssh_key
  encryptedPayload Bytes // AES-256-GCM 암호문(+ nonce/태그 포함해서 저장)
  createdAt        DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  projectGitRepos ProjectGitRepo[]

  @@index([userId])
}

// ---------------------------------------------------------------- 계층: 팀/그룹/프로젝트

model Team {
  id        String   @id @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  projectGroups ProjectGroup[]
  templateFiles TemplateFile[]
  trackingCodes TrackingCode[]
  admins        TeamAdmin[]
  apiKeys       ApiKey[]
}

// 팀 관리자("팀장") - 팀 소속 프로젝트 그룹 하위 프로젝트가 숨김 처리돼도
// 계속 보고 해제할 수 있는 설계자(Project.hidden 참고). 팀 자체 쓰기가
// 지금까지 authenticate만 요구해온 것과 같은 인가 수준을 그대로 따른다
// (설치 단위 admin role 자체가 아직 없다는 기존 한계의 연장).
model TeamAdmin {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model ProjectGroup {
  id        String   @id @default(cuid())
  teamId    String?
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  team          Team?               @relation(fields: [teamId], references: [id])
  projects      Project[]
  templateFiles TemplateFile[]
  admins        ProjectGroupAdmin[]

  @@index([teamId])
}

// TeamAdmin과 동일한 모양 - 팀 관리자는 자기 팀 산하 모든 그룹에
// 대해서도 자동으로 그룹 관리자 권한을 갖는다(core/projectGroupAdmins.ts
// 의 isProjectGroupAdmin() 참고 - 위→아래로 흐르는 상속, DB에 별도
// 행을 만들진 않음).
model ProjectGroupAdmin {
  id             String   @id @default(cuid())
  projectGroupId String
  userId         String
  createdAt      DateTime @default(now())

  projectGroup ProjectGroup @relation(fields: [projectGroupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([projectGroupId, userId])
  @@index([userId])
}

model Project {
  id             String   @id @default(cuid())
  projectGroupId String
  name           String
  hidden         Boolean  @default(false)
  hiddenBy       String?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())

  projectGroup    ProjectGroup     @relation(fields: [projectGroupId], references: [id])
  hiddenByUser    User?            @relation("ProjectHiddenBy", fields: [hiddenBy], references: [id])
  gitRepo         ProjectGitRepo?
  members         Member[]
  docTypes        DocType[]
  documents       Document[]
  comments        Comment[]
  questions       Question[]
  pushHookPrompts PushHookPrompt[]
  messages        Message[]
  templateFiles   TemplateFile[]
  trackingCodes   TrackingCode[]
  folders         Folder[]
  accessOverrides DocAccessOverride[]
  apiKeys         ApiKey[]
  kanbanColumns   KanbanColumn[]
  kanbanCards     KanbanCard[]
  gitSyncQueueEntries GitSyncQueueEntry[]
  codeRelations   CodeRelation[]
  pullRequestMetas PullRequestMeta[]

  @@index([projectGroupId])
}

model ProjectGitRepo {
  id                     String  @id @default(cuid())
  projectId              String  @unique
  provider               String // self_hosted | github | gitlab
  repoUrl                String
  externalRepoId         String?
  gitCredentialId        String?
  webhookSecretEncrypted Bytes? // AES-256-GCM - 수신 웹훅 서명/토큰 검증용
  webhookAutoRegistered  Boolean   @default(false) // 외부(GitHub/GitLab) 저장소 자체에 웹훅 자동 등록 성공 여부
  webhookUrl             String? // 등록에 넘겼던(또는 넘길) 콜백 URL 그대로 - 나중에 수동 설정 안내를 다시 보여줄 때 provider를 따로 안 들고 있어도 재구성 없이 씀
  webhookFirstReceivedAt DateTime? // 그 외부 웹훅이 처음 실제로 호출된 시각(수동 설정 안내 카드를 언제 접을지 판단)

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gitCredential GitCredential? @relation(fields: [gitCredentialId], references: [id])

  @@index([gitCredentialId])
}

model Member {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // owner | editor | viewer
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- 문서 체계 (정규화된 타입/상태/전이)

model DocType {
  id        String   @id @default(cuid())
  projectId String
  code      String // 영문 2글자
  label     String
  guideline String? // "이 타입은 무엇을 하기 위한 것인가" 자연어 설명(선택)
  isDefault Boolean  @default(false) // 프로젝트 생성 시 자동으로 심어진 기본 타입인지 - true면 이름(code/label) 수정 불가, 삭제만 가능
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statuses        DocStatus[]
  documents       Document[]
  accessOverrides DocAccessOverride[]

  @@index([projectId])
}

model DocStatus {
  id         String  @id @default(cuid())
  docTypeId  String
  code       String
  label      String
  guideline  String? // 표준 상태 코드(draft/review/pending/approved/deprecated/archived)의 고정 의미 - core/docTypes.ts의 STANDARD_DOC_STATUSES에서 그대로 채워짐, 관리자가 수정 불가
  isTerminal Boolean @default(false)

  docType   DocType    @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([docTypeId, code])
}

// ---------------------------------------------------------------- 문서/링크/버전이력

model Document {
  id           String   @id @default(cuid())
  projectId    String
  docTypeId    String
  trackingCode String   @unique // "XX-XXXXXXXX"
  title        String
  body         String
  statusId     String
  priority     Int?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  docType DocType   @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  status  DocStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  creator User      @relation("DocumentCreatedBy", fields: [createdBy], references: [id])

  revisions          DocumentRevision[]
  linksOut           DocumentLink[]       @relation("DocumentLinkSource")
  linksIn            DocumentLink[]       @relation("DocumentLinkTarget")
  questionReferences QuestionReference[]
  codeRelationRefs   CodeRelationRef[]
  accessOverrides    DocAccessOverride[]
  folderEntries      DocumentFolderEntry[]
  sourceLinks        DocumentSourceLink[]
  branchLinks        DocumentBranchLink[]
  kanbanCardRefs     KanbanCardDocumentRef[]

  @@index([projectId])
  @@index([docTypeId])
  @@index([statusId])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  body       String
  editedBy   String
  editedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User     @relation("RevisionEditedBy", fields: [editedBy], references: [id])

  @@index([documentId])
}

// toTrackingCode를 Document.trackingCode로 향한 실제 FK로 걸어서
// (문자열 느슨한 매칭이 아니라) 역참조 join이 자연스럽게 되게 한다.
model DocumentLink {
  id             String  @id @default(cuid())
  fromDocumentId String
  toTrackingCode String
  linkType       String?

  fromDocument Document @relation("DocumentLinkSource", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument   Document @relation("DocumentLinkTarget", fields: [toTrackingCode], references: [trackingCode], onDelete: Cascade)

  @@index([fromDocumentId])
  @@index([toTrackingCode])
}

// ---------------------------------------------------------------- 질의/답변 (Question/Answer)
// targetType/targetKey로 다형화 - document/kanbanCard면 그 자신의
// 트래킹 코드, source면 git 저장소 루트 기준 파일 경로. 폴리모픽이라
// 단일 FK로 못 묶는다(Prisma 근본 제약) - 대상이 지워질 때의 정리는
// 호출부(core/documents.ts의 deleteDocument())가 명시적으로 한다.
// kind로 "승인 요청"/"답변 요청"을 구분한다.
model Question {
  id           String   @id @default(cuid())
  projectId    String
  targetType   String   // "document" | "source" | "kanbanCard"
  targetKey    String
  trackingCode String   @unique // "QU-XXXXXXXX"
  ordinal      Int
  kind         String   // "approval" | "answer"
  text         String
  askedBy      String
  status       String   @default("open") // open(AI 질의, 설계자 답변 대기) | pending(설계자 답변 완료, AI 확인 대기) | resolved(AI 확인 완료)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asker   User    @relation("QuestionAskedBy", fields: [askedBy], references: [id])
  answer  Answer?
  refs    QuestionReference[]
  options QuestionOption[]

  @@index([projectId])
  @@index([targetType, targetKey])
}

// AI가 질의를 등록할 때 판단에 참고한 문서들을 구조적으로 태깅(DocumentLink와
// 같은 조인 테이블 패턴 - 본문 텍스트에 욱여넣지 않는다).
model QuestionReference {
  id           String   @id @default(cuid())
  questionId   String
  trackingCode String
  createdAt    DateTime @default(now())

  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  referencedDocument Document @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([questionId, trackingCode])
  @@index([trackingCode])
}

// AI가 답변 요청 질문에 제안하는 선택지 - 클릭하면 라벨이 그대로
// 답변 수동 입력칸에 반영된다(제출은 별도 - 검토 후 확정 제출).
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  detail     String?
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// body는 kind="answer"일 때 필수(자유 텍스트 답변), kind="approval"일
// 때는 선택(승인/거부 버튼에 곁들이는 메모) - decision은 그 반대로
// approval일 때만 채워진다.
model Answer {
  id         String   @id @default(cuid())
  questionId String   @unique
  decision   String? // "approved" | "rejected" - kind="approval"일 때만
  body       String?
  answeredBy String
  answeredAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation("AnswerAnsweredBy", fields: [answeredBy], references: [id])
}

// ---------------------------------------------------------------- 코멘트
// Question과 같은 targetType/targetKey 다형화. 지난 라운드에서 편집/
// 삭제를 지원하려고 따로 만들었던 KanbanCardComment는 이제 이 모델이
// 편집/삭제를 직접 지원하면서 필요 없어져 흡수됐다(targetType:
// "kanbanCard").
model Comment {
  id         String    @id @default(cuid())
  projectId  String
  targetType String    // "document" | "source" | "kanbanCard"
  targetKey  String
  body       String
  authorId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  status     String    @default("open") // open | closed | solved | etc - 작성자 본인만 변경 가능

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@index([targetType, targetKey])
}

// ---------------------------------------------------------------- git push 훅 프롬프트 자동화

model PushHookPrompt {
  id             String  @id @default(cuid())
  projectId      String
  triggerBranch  String?
  promptTemplate String
  createdAt      DateTime @default(now())

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queueEntries PushHookQueueEntry[]

  @@index([projectId])
}

model PushHookQueueEntry {
  id               String   @id @default(cuid())
  pushHookPromptId String
  commitSha        String
  status           String   @default("pending") // pending | acknowledged | done | expired
  triggeredAt      DateTime @default(now())

  // 프롬프트 설정이 삭제되면 그 프롬프트가 쌓은 큐 항목도 같이 정리한다
  // (큐 항목은 프롬프트의 promptTemplate/triggerBranch를 join으로
  // 참고하므로, 프롬프트가 사라지면 맥락 없는 고아 레코드가 된다 -
  // deletePushHookPrompt()가 FK 위반 없이 항상 삭제되게 하는 실질적
  // 이유이기도 함, 실제 테스트에서 FK violation을 직접 겪고 수정함).
  pushHookPrompt PushHookPrompt @relation(fields: [pushHookPromptId], references: [id], onDelete: Cascade)

  @@index([pushHookPromptId])
}

// ---------------------------------------------------------------- 검색 엔진 장애 대응 큐
// Meilisearch가 죽어 있는 동안(REST 호출 실패) 놓친 색인 쓰기를 여기
// 적재해뒀다가, 장애가 풀리면 워커(drainSearchSyncQueue)가 일괄
// 재처리한다(#meilisearch-spof - 설계자가 명시적으로 요청한 스키마
// 변경). FK 관계를 두지 않는다 - trackingCode/projectId는 Comment의
// targetType/targetKey처럼 존재가 보장되지 않는 느슨한 참조라(문서가
// 이미 삭제된 뒤에도 그 트래킹 코드를 가리키는 항목이 남을 수 있음).
model SearchSyncQueueEntry {
  id           String   @id @default(cuid())
  kind         String   // upsertDocument | deleteDocument | resyncProjectSourceFiles
  trackingCode String   @default("") // upsertDocument/deleteDocument 전용, 그 외엔 ""
  projectId    String   @default("") // resyncProjectSourceFiles 전용, 그 외엔 ""
  createdAt    DateTime @default(now())

  // trackingCode/projectId를 nullable로 두지 않고 빈 문자열 기본값으로
  // 통일한 이유: NULL을 포함한 복합 유니크 제약은 DB마다 취급이 달라
  // (NULL은 보통 "서로 다른 값"으로 간주돼 제약이 무력화될 수 있음)
  // 세 DB 백엔드에서 동일하게 "같은 대상 중복 적재 방지"로 동작하려면
  // 항상 값을 채워야 한다.
  @@unique([kind, trackingCode, projectId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- 인스턴스 메시징

model Message {
  id          String    @id @default(cuid())
  projectId   String
  authorId    String? // null이면 시스템 브로드캐스트
  body        String
  deliveredAt DateTime? // AI(CLI/MCP)가 읽어간 시각 - 분류(대기/처리중/기록)와는 별개 축
  ackedAt     DateTime? // null="대기", 있으면 AI가 명시적으로 ack해 "처리중"
  completedAt DateTime? // 있으면 "기록"(ackedAt도 같이 채워짐)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([projectId])
}

// 외부(권위) 저장소 동기화(발행)가 즉시 fast-forward로 반영 못 하는
// 경우(충돌) 대기열에 올린다 - PushHookQueueEntry가 projectId를
// 직접 안 가져서 보안 재확인이 필요했던 전례(core/pushHookPrompts.ts
// 의 transitionQueueEntry 주석 참고)를 반영해 이번엔 처음부터 직접
// 보유한다. 같이 보낸 프로젝트 메시지(core/messages.ts)는 별도로
// 연결하지 않는다 - AI는 평소처럼 `message wait`로 받아보면 되고,
// 이 큐는 "동기화 버튼 재활성화 여부"만 추적하면 충분하다.
model GitSyncQueueEntry {
  id        String   @id @default(cuid())
  projectId String
  status    String   @default("pending") // pending | done
  reason    String // "diverged" | "push_failed"
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------- 템플릿 파일 (CLAUDE.md, SKILL.md 등)
// teamId/projectGroupId/projectId 중 정확히 하나만 채워지는 스코프
// 오버라이드, 셋 다 null이면 설치 전역 기본값. DocType과 같은 스코프
// 패턴 - filename별로 별도 테이블을 늘리지 않고 하나로 일반화.

model TemplateFile {
  id             String   @id @default(cuid())
  teamId         String?
  projectGroupId String?
  projectId      String?
  filename       String // 예: "CLAUDE.md", ".claude/skills/claude-native-workflow/SKILL.md"
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team         Team?              @relation(fields: [teamId], references: [id])
  projectGroup ProjectGroup?      @relation(fields: [projectGroupId], references: [id])
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions    TemplateRevision[]

  @@unique([teamId, projectGroupId, projectId, filename])
  @@index([teamId])
  @@index([projectGroupId])
  @@index([projectId])
}

model TemplateRevision {
  id             String   @id @default(cuid())
  templateFileId String
  content        String
  editedBy       String
  editedAt       DateTime @default(now())

  templateFile TemplateFile @relation(fields: [templateFileId], references: [id], onDelete: Cascade)
  editor       User         @relation("TemplateRevisionEditedBy", fields: [editedBy], references: [id])

  @@index([templateFileId])
}

// ---------------------------------------------------------------- 문서 정리용 폴더 (DB 전용, AI는 모름)
// 설계자 개인 소유 - createdBy가 곧 소유자다(다른 설계자는 이 폴더의
// 존재 자체를 조회할 수 없음, core/folders.ts가 항상 projectId+createdBy로
// 필터). order는 같은 부모+소유자 형제 사이의 표시 순서(생성 시 끝에 추가).
// CLI/MCP엔 이 모델 관련 명령/도구가 전혀 없고, 문서 조회 공용 라우트
// 응답에도 폴더 정보를 얹지 않는다 - 웹 UI 전용 라우트로만 접근.
model Folder {
  id             String   @id @default(cuid())
  projectId      String
  parentFolderId String?
  name           String
  order          Int      @default(0)
  createdBy      String
  createdAt      DateTime @default(now())

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder Folder?              @relation("FolderChildren", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders Folder[]             @relation("FolderChildren")
  creator      User                 @relation(fields: [createdBy], references: [id])
  entries      DocumentFolderEntry[]

  // 같은 부모+소유자 아래 동명 폴더 금지는 parentFolderId가 nullable이라
  // (여러 드라이버가 NULL끼리는 유니크 위반으로 안 침) DB 제약이 아니라
  // core/folders.ts의 애플리케이션 레벨 findFirst 검사로 강제한다.
  @@index([projectId, parentFolderId])
}

// 문서 하나를 여러 설계자가 각자 자신의 개인 폴더에 서로 다르게(혹은
// 아무 폴더에도 안) 배치할 수 있어야 해서, Document.folderId 단일
// 컬럼 대신 (document, user)당 최대 한 행인 조인 테이블로 배치를
// 표현한다 - 행이 없으면 그 설계자에게는 "미분류".
model DocumentFolderEntry {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  folderId   String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
  @@index([folderId])
  @@index([userId])
}

// 문서 ↔ "연관된 소스코드" 파일 경로 - git 저장소 루트 기준 상대 경로
// 문자열만 저장한다(그 경로가 실제로 존재하는지는 검증하지 않음 -
// 순수 연관 관계, CLI/MCP에도 노출되는 AI 가시 기능).
model DocumentSourceLink {
  id         String   @id @default(cuid())
  documentId String
  filePath   String
  createdBy  String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, filePath])
  @@index([documentId])
}

// ---------------------------------------------------------------- 코드 관계도(Code Relation Graph)
// Claude가 코드 탐색 중 스스로 발견한 "무엇을, 어디서, 왜 참조했는지"를
// 기록해 다음 세션이 재탐색 없이 빠르게 찾아 쓰게 하는 자기 기록형
// 그래프 - Folder와 동일 원칙으로 프로젝트 내에서 설계자(userId) 개인
// 소유이고 다른 설계자와 공유되지 않는다(개인화 기능). 상위/하위 관계는
// 단일 parentId 트리가 아니라 CodeRelationEdge 다대다 조인 테이블로
// 표현한다 - 노드 하나가 여러 부모/여러 자식을 가질 수 있고, 순환도
// 허용한다(설계자 지시 - 범용 그래프 엔진).
model CodeRelation {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  target    String   // 무엇을 참조했는지(심볼명/추적코드/식별자 등 자유 텍스트)
  referrer  String   // 어디서 참조했는지(참조 주체 - 함수/컴포넌트/문서 등 자유 텍스트)
  purpose   String   // 무슨 목적으로 참조했는지
  filePath  String   // 어떤 파일에서 발견했는지(저장소 루트 기준 상대 경로)
  line      Int?     // 발견 위치(줄) - 모르면 null
  column    Int?     // 발견 위치(열) - 모르면 null
  data      String?  // 임의 추가 데이터 - JSON.stringify 텍스트(Json 타입 미사용 - 스키마 전체 관례)
  // CLI/MCP가 실행 디렉터리의 `git rev-parse --abbrev-ref HEAD`로 자동
  // 감지한 작업 브랜치(명시적으로 --branch를 줄 수도 있음). null은
  // "브랜치 무관"(기존 데이터, 또는 감지 실패) - --all-branches 조회에서만
  // 보인다. 이 브랜치가 삭제되면(웹훅 delete 이벤트) 이 행 전체가
  // deleteRelationsForBranch()로 일괄 삭제된다(설계자 지시 - "지금 탐색
  // 상태"라 사라진 브랜치를 계속 가리키면 오해를 부름, DocumentBranchLink는
  // 반대로 영구 보존 - 그 모델 주석 참고).
  branchName String?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id])
  tags    CodeRelationTag[]
  // 연관된 문서 추적 코드(여러 개 가능) - QuestionReference와 동일한
  // 조인 테이블 패턴(AI가 질의에 참고 문서를 구조적으로 태깅하는 것과
  // 같은 원칙) - 문서 쪽에서 "관계도에서 보기"로 역참조할 때 이걸로
  // 정확히 필터링한다(target/purpose 자유 텍스트 안의 우연한 일치와
  // 구분).
  refs CodeRelationRef[]
  // 이 관계가 자식인 엣지들(→ 상위 찾기) / 이 관계가 부모인 엣지들(→ 하위 찾기)
  parentEdges CodeRelationEdge[] @relation("EdgeChild")
  childEdges  CodeRelationEdge[] @relation("EdgeParent")

  @@index([projectId, userId])
  @@index([projectId, userId, target])
  @@index([projectId, userId, filePath])
  @@index([projectId, userId, branchName])
}

// 태그(다중 지정 가능) - String[]/Json 미사용, 조인 테이블
// (DocumentFolderEntry와 동일 관례). 관계 하나에 같은 태그 중복 방지.
model CodeRelationTag {
  id         String @id @default(cuid())
  relationId String
  tag        String

  relation CodeRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, tag])
  @@index([tag])
}

// QuestionReference와 동일한 조인 테이블 패턴 + Document.trackingCode로의
// 실제 FK(그 문서가 삭제되면 이 참조 행도 같이 정리됨) - 관계 하나가
// 여러 문서를 동시에 연관 지을 수 있다.
model CodeRelationRef {
  id           String   @id @default(cuid())
  relationId   String
  trackingCode String
  createdAt    DateTime @default(now())

  relation           CodeRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  referencedDocument Document     @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([relationId, trackingCode])
  @@index([trackingCode])
}

// 다중 부모/다중 자식을 지원하는 범용 그래프 엣지 - fromId(자식/하위) →
// toId(부모/상위) 방향의 "상위 관계" 링크. Folder류의 단일
// parentFolderId 트리와 달리 조인 테이블로 다대다를 표현하고 순환도
// 허용한다(실제 코드 관계는 상호 참조·순환 의존이 흔함 - 생성 시점에
// 막지 않고, 순회할 때만 방문 집합으로 무한 루프를 방지한다 -
// core/codeRelations.ts 참고). projectId/userId는 조회 스코프를 조인
// 없이 바로 필터링하기 위한 중복 저장이자, 설계자 경계를 넘는 엣지
// 생성 자체를 막는 가드로 쓰인다.
model CodeRelationEdge {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from CodeRelation @relation("EdgeChild", fields: [fromId], references: [id], onDelete: Cascade)
  to   CodeRelation @relation("EdgeParent", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId])
  @@index([fromId])
}

// ---------------------------------------------------------------- 협업자별 세부 접근 권한
// project 공통 / docType 스코프 / document 스코프 중 정확히 하나만
// 채워짐(전부 null이면 "프로젝트 공통" 레벨) - 각 스코프 값이 null인
// 필드는 "이 레벨에서 명시 안 함, 더 넓은 기본값을 따름". null-스코프
// 유니크 문제(TemplateFile과 동일 이유)로 DB @@unique 대신
// core/permissions.ts가 findFirst 후 update/create. (폴더 스코프
// 오버라이드는 폐기됨 - 폴더가 항상 개인 소유라 다른 설계자의 폴더
// 쓰기를 제한한다는 개념 자체가 더 이상 성립하지 않음.)
model DocAccessOverride {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  docTypeId  String?
  documentId String?
  canRead    Boolean?
  canWrite   Boolean?
  canDelete  Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
  docType  DocType?  @relation(fields: [docTypeId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([userId])
  @@index([docTypeId])
  @@index([documentId])
}

// ---------------------------------------------------------------- API 키(신원 위임 인증)
// scope="personal"이면 projectId/teamId 둘 다 null(그 설계자가 접근
// 가능한 모든 프로젝트), "project"면 projectId만, "team"이면 teamId만
// 채워진다 - 셋 다 ownerId가 대행하는 신원이고, 스코프만 다르다.
// 원문(secret)은 저장하지 않는다(keyHash만) - "생성 시 1회만 노출,
// 이후엔 본인도 마스킹"을 구조적으로 강제하기 위함.
model ApiKey {
  id         String    @id @default(cuid())
  ownerId    String
  scope      String // personal | project | team
  projectId  String?
  teamId     String?
  label      String?
  keyPrefix  String
  keyHash    String    @unique
  status     String    @default("active") // active | revoked
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime? // null이면 배제 전까지 무기한
  revokedAt  DateTime?
  revokedBy  String?

  owner   User     @relation("ApiKeyOwner", fields: [ownerId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  revoker User?    @relation("ApiKeyRevoker", fields: [revokedBy], references: [id])

  @@index([ownerId])
  @@index([projectId])
  @@index([teamId])
}

// ---------------------------------------------------------------- 칸반 보드
// 컬럼(분류)은 프로젝트 공유 자원 - 순서/숨김만 설계자별로 다르게 볼 수
// 있다(KanbanColumnPref, null 필드는 "이 설계자가 커스텀 안 함 → 컬럼
// 자체의 기본값을 따름" - TemplateFile류와 같은 오버레이 패턴).
model KanbanColumn {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prefs   KanbanColumnPref[]
  cards   KanbanCard[]

  @@index([projectId])
}

model KanbanColumnPref {
  id       String   @id @default(cuid())
  columnId String
  userId   String
  order    Int?
  hidden   Boolean?

  column KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@unique([columnId, userId])
  @@index([userId])
}

// 카드는 문서/질문과 같은 원칙으로 트래킹 코드를 받는다("KB-XXXXXXXX").
// origin("ai"|"designer")으로 누가 만들었는지 구분 - 설계자가 만든
// 카드는 항상 "반드시 진행되어야 하는 작업"으로 간주된다(별도
// mandatory 컬럼 없이 origin이 그 의미를 겸함). hidden은 컬럼과 달리
// 설계자별이 아니라 전역(공유 보드의 실제 작업 항목이므로).
model KanbanCard {
  id           String   @id @default(cuid())
  projectId    String
  columnId     String
  trackingCode String   @unique // "KB-XXXXXXXX"
  title        String
  body         String?
  origin       String   // "ai" | "designer"
  hidden       Boolean  @default(false)
  order        Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   KanbanColumn            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  creator  User                    @relation("KanbanCardCreatedBy", fields: [createdBy], references: [id])
  docRefs  KanbanCardDocumentRef[]

  @@index([projectId])
  @@index([columnId])
}

// 카드가 근거로 삼은 문서들 - QuestionReference와 동일한 조인 테이블
// 패턴(카드 다이얼로그의 "근거 문서" 목록).
model KanbanCardDocumentRef {
  id           String @id @default(cuid())
  cardId       String
  trackingCode String

  card     KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  document Document   @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@unique([cardId, trackingCode])
  @@index([trackingCode])
}

// 카드별 코멘트는 더 이상 별도 모델이 아니다 - 공용 Comment
// (targetType:"kanbanCard", targetKey=카드의 트래킹 코드)로 흡수됨.

// ---------------------------------------------------------------- PR 워크플로우
// Gitea PR(#index) 자체는 state(open/closed)+merged(bool)만 주고
// "거부(rejected)" 개념이 없다(swagger.v1.json 실측 확인) - 이 앱만 아는
// 여분의 상태를 GitSyncQueueEntry와 같은 원칙(외부가 안 주는 상태만 얇게
// 기록)으로 얹는다. Gitea가 안정적인 내부 row id를 안 주고 프로젝트당
// 유일한 번호(index)만 주므로 (projectId, prIndex) 복합키로 건다.
model PullRequestMeta {
  id             String   @id @default(cuid())
  projectId      String
  prIndex        Int
  disposition    String?  // null | "merged" | "rejected"
  lastMergeError String?  // 자동 머지 실패 사유 - 새로고침 후에도 수동 병합 안내 배너를 유지하기 위해 보관

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, prIndex])
  @@index([projectId])
}

// 문서 ↔ "연관된 git 브랜치" - DocumentSourceLink와 완전히 같은 패턴
// (filePath 대신 branchName, 존재 검증 없는 순수 참조). CodeRelation.branchName과
// 반대로 **브랜치가 삭제돼도 이 행은 지우지 않는다** - "이 문서가 어느
// 브랜치들에서 구현됐는지"는 브랜치가 사라진 뒤(머지·정리 후)에도
// 역사적 기록으로 유용하다고 판단(설계자 지시대로 진행, 다르게 보시면
// 브랜치 삭제 시 함께 정리하도록 바꿀 수 있음).
model DocumentBranchLink {
  id         String   @id @default(cuid())
  documentId String
  branchName String
  createdBy  String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, branchName])
  @@index([documentId])
}
