// v3 scaffold schema - PostgreSQL only (no multi-DB variants, unlike v2).
// Field-level detail will be refined once real action handlers are implemented;
// this exists so `prisma generate`/`migrate dev` prove the entity list end to end.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum MembershipRole {
  READ
  WRITE
  ADMIN
}

enum InviteState {
  PENDING
  ACCEPTED
}

// account = a login-capable identity. "architectId" in docs/design-notes.md == Account.id.
model Account {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // 계정 관리(docs/plan-account-management.md) - null이면 정상, 값이
  // 있으면 로그인이 거부된다(superAdmin만 disable/enable 가능). v2에
  // 없던 신규 기능 - 삭제와 달리 되돌릴 수 있는 "잠금"이라 별도 필드로 둔다.
  disabledAt   DateTime?

  // docs/plan-nickname-apikey-policy.md - v2 정책 그대로 계승: nickname은
  // null 허용에 중복도 허용(표시 라벨은 항상 "{nickname ?? '설계자'} #{번호}").
  // 그 라벨 풀(같은 nickname 문자열, 또는 미설정이면 공통 풀 "설계자") 안에서
  // 몇 번째로 그 라벨을 쓰게 됐는지를 nicknameNumber에 "그 라벨로 바뀌는
  // 시점에만" 확정 저장한다(매 조회마다 다시 세지 않음 - v2 core/auth.ts의
  // nextNicknameNumber() 계승). nicknameChangedAt은 7일 변경 쿨다운 기준.
  nickname          String?
  nicknameNumber    Int       @default(1)
  nicknameChangedAt DateTime?

  memberships              ProjectMembership[]
  invites                  ProjectInvite[]
  apiKeys                  ApiKey[]
  remembers                RememberItem[]
  templates                Template[]
  createdProjects          Project[]           @relation("ProjectCreator")
  pushMirrorGithubProjects Project[]           @relation("ProjectPushMirrorGithub")
  githubCredential         GithubCredential?
}

model Project {
  id                String     @id @default(cuid())
  name              String
  description       String?
  visibility        Visibility @default(PRIVATE)
  defaultBranch     String     @default("main")
  messageTtlDefault Int        @default(-1)
  pushMirrorUrl     String? // 옵션 push-mirror 대상 (design-notes.md "저장소(git) 관리" - 외부로의 동기화는 옵션)
  createdAt         DateTime   @default(now())

  // 설계자 요청(2026-09-22 후속, "GitHub 로그인") - Gitea는 서버 전체가
  // 공유하는 서비스 계정 토큰(GITEA_API_TOKEN)이라 프로젝트마다 물을
  // 필요가 없었지만, GitHub OAuth 토큰은 그걸 연결한 architect 개인
  // 소유라 "이 프로젝트의 push가 누구 토큰을 쓸지"를 프로젝트마다
  // 기록해야 한다 - Gitea로 연결된 프로젝트는 이 필드가 계속 null이다
  // (서버 공유 토큰을 그냥 쓰므로). 그 계정이 삭제되면 push-mirror가
  // 더 이상 동작하지 않을 뿐 다른 데이터에 영향 없게 SetNull.
  pushMirrorGithubAccountId String?
  pushMirrorGithubAccount   Account? @relation("ProjectPushMirrorGithub", fields: [pushMirrorGithubAccountId], references: [id], onDelete: SetNull)

  // 설계자 요청(2026-09-21 후속) - 웹 접속 path를 /{생성자 login명}/{project id}로
  // 바꾸면서 필요해졌다. Admin은 project.transfer로 넘어갈 수 있어(현재 Admin ==
  // 생성자가 아닐 수 있음) 별도로 "생성자"를 영구 기록해야 한다 - transfer가 일어나도
  // 이 필드는 안 바뀐다(URL도 그대로 유지).
  creatorAccountId String
  // 계정 관리(docs/plan-account-management.md, "콘텐츠 보존" 결정) - 일부러
  // Cascade를 걸지 않는다: 계정을 지운다고 그 사람이 만든 프로젝트 전체
  // (그 안의 Document/PR 등 모든 콘텐츠)가 통째로 사라지면 안 된다는
  // 판단 - accounts.ts의 accountDelete()가 "생성한 프로젝트가 남아있으면
  // project.transfer로 먼저 넘기라"고 앞단에서 막고, 이 Restrict는 그
  // 검증을 우회해도 DB가 막아주는 마지막 방어선이다.
  creator          Account @relation("ProjectCreator", fields: [creatorAccountId], references: [id], onDelete: Restrict)

  // 설계자 요청(2026-09-21 추가 후속) - "프로젝트 id는 설계자별로 관리되어야
  // 한다"(서로 다른 두 설계자가 똑같은 id로 각자 프로젝트를 가질 수 있어야
  // 함) - 그래서 이 값(설계자가 만들 때 직접 고르는 문자열, 웹 URL/CLI/API가
  // "projectId"라고 부르는 바로 그 값)은 전역 유일이 아니라 `creatorAccountId`
  // 범위에서만 유일하다(`@@unique([creatorAccountId, slug])`). 위의 `id`
  // (cuid)는 여전히 전역 유일한 내부 PK로 남아 Document/PullRequest 등
  // 모든 관계가 그대로 이 필드를 참조한다 - 이 프로젝트 자체는 스키마
  // 변경이 전혀 없다. `owner`(생성자 username)+`slug` 쌍을 실제 내부 PK로
  // 바꾸는 변환은 API 진입점 한 곳(`core/projectResolve.ts` +
  // `api/actions.ts`의 dispatch(), `api/rest.ts`의 web())에만 있다 -
  // 그 아래 모든 액션 핸들러는 지금까지처럼 `payload.projectId`를 "이미
  // 유일하게 식별된 내부 PK"로 그대로 취급한다.
  slug String

  memberships   ProjectMembership[]
  invites       ProjectInvite[]
  documents     Document[]
  remembers     RememberItem[]
  messages      Message[]
  webhooks      Webhook[]
  pullRequests  PullRequest[]
  apiKeys       ApiKey[]
  activityLogs  ActivityLog[]
  documentKinds DocumentKind[]

  @@unique([creatorAccountId, slug])
}

model ProjectMembership {
  id        String         @id @default(cuid())
  projectId String
  accountId String
  role      MembershipRole
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 계정 삭제(docs/plan-account-management.md) - 멤버십은 "그 계정이 가진
  // 접근 권한"일 뿐 다른 사람의 콘텐츠가 아니므로 계정과 함께 사라져도
  // 된다(그 프로젝트 자체나 문서는 전혀 안 건드림).
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
}

model ProjectInvite {
  id        String         @id @default(cuid())
  projectId String
  accountId String
  role      MembershipRole
  state     InviteState    @default(PENDING)
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([projectId, accountId])
}

// docs/plan-nickname-apikey-policy.md - v2의 "개인 키/프로젝트 키"
// 구분을 계승한다(v2의 "팀 키"는 v3에 팀 개념 자체가 없어 대상 아님).
// `scope: "personal"`(projectId null, 로그인과 동등하게 무제한)과
// `scope: "project"`(그 프로젝트 안에서만 유효 - `core/requestScope.ts`
// +`core/membership.ts`의 `requireMembership`이 매 액션마다 강제)로
// 나뉜다. 로그인이 만드는 키는 항상 personal(v2도 로그인=JWT는
// unrestricted와 동급으로 취급했다). "삭제"가 아니라 `revokedAt`
// soft-revoke로 남긴다(v2 판단 계승 - "누가 언제 어떤 범위의 신원을
// 위임받았었는가"라는 이력 자체가 감사 가치가 있다).
model ApiKey {
  id         String    @id @default(cuid())
  accountId  String
  keyHash    String    @unique
  // 목록 화면에서 원문 노출 없이 구분하는 용도(v2의 keyPrefix 계승) -
  // "cnwk_" + 앞 6자 정도.
  keyPrefix  String    @default("")
  scope      String    @default("personal") // "personal" | "project"
  projectId  String? // scope === "project"일 때만
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  // 계정 삭제/비활성화 시 그 계정의 키도 같이 무효화된다 - 자격증명은
  // "콘텐츠"가 아니라 그 계정 자신의 것이라 보존 대상이 아니다.
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([projectId])
}

// type/kind/state are validated at the application layer (docs/design-notes.md
// "문서 상태 전이 규칙") rather than as DB enums, since valid kind/state combos
// differ per type.
model Document {
  id        String   @id // 8-char [A-Z0-9], generated by the app (trackingCode.ts) - tracking code = `${kind}-${id}`
  parentId  String?
  projectId String
  etag      String
  type      String
  kind      String
  state     String
  branch    String?
  commitId  String?
  chapter   String? // question/opinion이 부모 doc의 특정 챕터(헤딩 제목)를 가리킬 때만 사용
  title     String
  author    String
  content   String   @default("")
  fileRefs  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Document?  @relation("DocumentChain", fields: [parentId], references: [id])
  children Document[] @relation("DocumentChain")

  // related/dependsOn을 JSON 배열로 뒀던 Phase 1 스캐폴딩("이번 라운드엔
  // 조인 테이블 대신 Json 컬럼으로 단순화 - 다음 라운드에서 필요하면
  // 정규화")을 실제로 정규화한 것 - 설계자 지시대로 하나의 공용 테이블에
  // kind 구분 컬럼을 두는 대신, related/dependsOn을 각각 별도 테이블로
  // 완전히 분리했다(의미가 다른 두 관계라 스키마 차원에서도 분리하는 게
  // 맞다는 판단). 둘 다 DB 인덱스(@@index([targetId]))로 역참조(backlinks)
  // 조회를 지원한다. API 응답의 related/dependsOn 필드 모양({code,etag}[])
  // 자체는 바뀌지 않는다 - refs.ts가 이 관계를 그 모양으로 다시 조립한다.
  relatedFrom   DocumentRelated[]   @relation("DocumentRelatedFrom")
  relatedTo     DocumentRelated[]   @relation("DocumentRelatedTo")
  dependsOnFrom DocumentDependsOn[] @relation("DocumentDependsOnFrom")
  dependsOnTo   DocumentDependsOn[] @relation("DocumentDependsOnTo")

  @@index([projectId, type, kind, state])
}

// Document.related의 정규화된 형태 - 한 문서(documentId)가 다른 문서
// (targetId)를 "관련 문서"로 태깅한 것 하나당 행 하나. etag는 태깅
// 시점에 검증했던 대상의 etag 스냅샷(verifyTaggedRefs 그대로).
model DocumentRelated {
  id         String   @id @default(cuid())
  documentId String
  targetId   String
  etag       String
  createdAt  DateTime @default(now())

  document Document @relation("DocumentRelatedFrom", fields: [documentId], references: [id], onDelete: Cascade)
  target   Document @relation("DocumentRelatedTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([documentId, targetId])
  @@index([targetId])
}

// Document.dependsOn의 정규화된 형태 - "이 문서(documentId)가 해소되려면
// target이 먼저 끝나야 한다"는 의존 관계 하나당 행 하나. related와 의미가
// 달라(방향성 있는 readiness 그래프 엣지) 같은 테이블에 kind로 묶지 않고
// 완전히 별도 테이블로 뒀다.
model DocumentDependsOn {
  id         String   @id @default(cuid())
  documentId String
  targetId   String
  etag       String
  createdAt  DateTime @default(now())

  document Document @relation("DocumentDependsOnFrom", fields: [documentId], references: [id], onDelete: Cascade)
  target   Document @relation("DocumentDependsOnTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([documentId, targetId])
  @@index([targetId])
}

model RememberItem {
  id             String   @id @default(cuid())
  projectId      String
  ownerAccountId String
  category       String
  title          String
  summary        String
  content        String
  related        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 계정 삭제 시 같이 사라진다 - 이 개인화 메모리는 그 architect
  // 자신만을 위한 것이라 다른 사람이 참조하는 "콘텐츠"가 아니다.
  owner   Account @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)

  @@unique([projectId, ownerAccountId, id])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  from      String
  to        String
  body      String
  state     String   @default("sent")
  ttl       Int      @default(-1)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// architect별 개인 템플릿 - 전역 기본 템플릿은 없다.
model Template {
  id             String   @id @default(cuid())
  ownerAccountId String
  claudeMd       String
  skillMd        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 계정 삭제 시 같이 사라진다 - 계정 하나에 묶인 개인 템플릿이라
  // 그 계정이 없으면 어차피 배포(template.deploy)할 주체도 없다.
  owner Account @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)

  @@unique([ownerAccountId])
}

// 프로젝트별 외부 연동 웹훅(design-notes.md "프로젝트 설정 항목" - "Webhook/
// 외부 연동 설정") - 문서 CRUD 이벤트(EMQX cnw/<projectId>/docs와 같은
// 이벤트)가 생길 때마다 이 프로젝트에 등록된 모든 대상 URL로 HMAC-SHA256
// 서명된 POST를 보낸다(webhooks.ts). secret은 등록 시 서버가 생성해 그
// 순간에만 응답으로 돌려주고, 이후 webhook.list 조회에는 다시 노출하지
// 않는다(재발급하려면 삭제 후 재등록).
model Webhook {
  id        String   @id @default(cuid())
  projectId String
  url       String
  secret    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Code/Pull requests 탭(설계자 요청, 2026-09-20) - Document 타입 체계에
// 얹지 않고 별도 엔티티로 뒀다(문서 상태 전이 규칙이 open/merged/closed +
// 브랜치 머지라는 완전히 다른 시맨틱과는 안 맞는다는 판단). 실제 diff는
// 저장하지 않고 매번 es-git으로 그때그때 계산한다(gitRepo.ts
// diffBranches) - 저장할 게 있다면 그건 정본이 아니라 캐시일 뿐이라
// 이번 스코프에선 아예 안 둔다.
// 설계자 요청(2026-09-22 후속) - "각 추적 코드별로 어떤 동작을 언제
// 얼마나 했는지" 종합 현황에서 히트맵/활동 로그로 보여주기 위한 원천
// 기록. code는 Document.id(8자 PK)가 아니라 완전한 추적 코드 문자열
// (`${kind}-${id}`)을 그대로 저장한다 - 그 문서가 나중에 지워져도(예:
// answer 철회) "그 코드에 그 시점에 그 동작이 있었다"는 이력 자체는
// 남아야 하므로 FK가 아니라 평문 문자열로 둔다.
// 설계자 요청(2026-09-22 후속, "GitHub 로그인") - GitHub OAuth로 연결한
// architect 개인의 재사용 가능한 자격증명(계정당 하나) - push-mirror가
// GitHub 저장소일 때 push 시점에 이 토큰을 꺼내 쓴다(core/gitRepo.ts의
// pushCredentialFor). **보안 트레이드오프(의도적, docs/design-notes.md
// 기록)**: 이 저장소엔 아직 대칭키 암호화 유틸이 없고 push 시점에 평문이
// 다시 필요해서 해시할 수 없다 - 기존 Webhook.secret과 같은 원칙(평문
// 저장 + API 응답에 절대 재노출 안 함)으로 둔다. 나중에 서버 전체
// 암호화 계층이 생기면 재검토 대상.
model GithubCredential {
  id          String   @id @default(cuid())
  accountId   String   @unique
  accessToken String
  githubLogin String?
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  code      String
  action    String
  channel   String
  actorId   String
  // 설계자 요청(2026-09-22 후속) - "AI 에이전트 N개와 설계자 1명이 같은
  // 계정으로 작업한다" - actorId(계정)만으로는 그 N개를 구별할 수 없어
  // CLI/MCP가 선택적으로 보내는 자기 식별자(channel.ts resolveAgentId)를
  // 따로 둔다. WEB UI(architect)는 항상 null.
  agentId   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, code, createdAt])
}

// 설계자 요청(2026-09-22 후속) - "문서 분류(kind)도 추가/수정 가능해야
// 하고, 분류별 지침 관리도 가능해야 한다" - doc 타입의 5개 기본 분류
// (SP/RP/RM/QA/BT, documentRules.ts KINDS_BY_TYPE)는 여전히 하드코딩된
// 기본값으로 남고, 이 테이블은 "오버레이"다: 기본 code로 행이 있으면
// 라벨/지침을 덮어쓰고(수정), 기본에 없는 code면 완전히 새 분류다(추가).
// 프로젝트 생성 시 5개 행을 미리 심을 필요가 없다 - 오래된 프로젝트도
// 자동으로 기본값을 그대로 갖는다. 범위는 프로젝트별(설계자 확인) -
// Template처럼 계정 전체 공용이 아니다.
model DocumentKind {
  id        String   @id @default(cuid())
  projectId String
  code      String
  label     String
  guideline String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
}

model PullRequest {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  description   String   @default("")
  sourceBranch  String
  targetBranch  String
  state         String   @default("open") // open | merged | closed
  author        String // channel: agent | architect
  mergeCommitId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
