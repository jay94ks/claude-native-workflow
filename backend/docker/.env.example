# docker-compose.yml이 읽는 시크릿. 이 파일을 .env로 복사한 뒤 실제 값을
# 채운다(.env 자체는 커밋 대상이 아님 - 저장소 .gitignore 확인).

POSTGRES_PASSWORD=change-me

# 최소 32자(무작위) 필요 - 짧으면 기동 자체가 실패한다. 예:
# `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# 정확히 32바이트를 hex 64자로 인코딩한 값이어야 한다 - 짧거나 길면
# 기동 자체가 실패한다. `openssl rand -hex 32`로 생성.
CREDENTIAL_ENCRYPTION_KEY=change-me-64-hex-chars-openssl-rand-hex-32

MEILISEARCH_API_KEY=change-me

# MEILISEARCH_API_KEY와 마찬가지로 어디서 발급받는 값이 아니라 본인이
# 직접 정하는 값이다 - docker-compose.yml이 이 두 값으로 EMQX의 REST
# API 키를 기동 시점에 자동으로 만들어준다(EMQX의 api_key.bootstrap_file
# 기능, 실제 emqx:5.8 컨테이너로 검증 완료 - 대시보드에서 수동으로 만든
# 키와 동일하게 동작함). 비워두면 backend는 뜨지만 실시간 발행
# (realtimePublish)/구독(message wait, EMQX 인증·인가 훅 자동 등록)이
# 전부 조용히 스킵된다. 이미 한 번 기동한 뒤 이 값을 바꿨다면
# `docker compose up -d --force-recreate emqx`처럼 명시적으로 재생성
# 해야 반영된다(평범한 `up -d`는 자동으로 재생성하지 않음).
EMQX_API_KEY=change-me
EMQX_API_SECRET=change-me

# 백엔드 자신이 message wait용으로 EMQX에 내부 연결할 때 쓰는 고정
# 서비스 계정(설계자/웹 UI가 쓰는 JWT 기반 인증과는 별개 - 신뢰된 내부
# 연결이라 모든 프로젝트 topic에 접근 허용됨). 무작위 값을 채운다.
# `openssl rand -hex 16` 등으로 생성.
EMQX_SERVICE_USERNAME=change-me
EMQX_SERVICE_PASSWORD=change-me

# Gitea 설정 - 보안 강화(#gitea-nginx-lockdown)로 Gitea의 웹 설치
# 마법사는 더 이상 쓰지 않는다(호스트 포트 자체를 안 연다) - 대신
# `docker exec` 기반 CLI로 관리자 계정/PAT를 발급한다(README.md "Gitea
# 설정" 절 참고: `gitea admin user create` + `gitea admin user
# generate-access-token`, scopes에 write:admin,write:organization,
# write:repository,write:user,write:issue 전부 포함). 세 값을 채우기
# 전까지는 backend가 뜨긴 하지만 git 저장소 연결/이력 조회 엔드포인트가
# 전부 에러를 반환한다.
GITEA_ADMIN_USERNAME=change-me
GITEA_API_TOKEN=

# 저장소는 더 이상 하나의 공유 조직이 아니라 프로젝트마다 별도 Gitea
# 조직(org)에 만들어진다(#gitea-per-project-namespace) - org 이름은
# 이 접두어 + projectId(예: proj-cktx...)로 자동 계산된다. 본인의
# Gitea 사용자명이나 다른 org와 겹치지 않을 접두어라면 바꿔도 무방 -
# 비워두면 "proj-".
GITEA_ORG_PREFIX=proj-

# self_hosted 저장소의 clone URL을 designer에게 보여줄 때 쓰는
# 외부(externally reachable) 주소 - Gitea 자신이 생성 시점에 돌려주는
# clone_url을 그대로 얼려두지 않고, 이 값이 설정돼 있으면 매 조회마다
# 다시 계산해서 돌려준다(#gitea-per-project-namespace - 도메인 이전/
# 로컬→원격 이전 뒤에도 즉시 반영됨). nginx가 `.git`로 끝나는 요청만
# Gitea로 그대로 돌려주므로(#gitea-nginx-lockdown, nginx.conf 참고)
# 보통 PUBLIC_BACKEND_URL과 같은 공개 주소를 그대로 쓰면 된다. 비워두면
# 저장소 생성 시점에 Gitea가 반환한 clone_url을 그대로 쓴다(로컬 개발
# 등 - 값이 안 바뀔 걸 알 때는 안 채워도 무방).
PUBLIC_GITEA_URL=

# 웹훅 콜백 주소(Gitea/GitHub/GitLab이 push 이벤트를 이 주소로 보낸다)
# + EMQX 인증/인가 훅 콜백 주소로 쓰인다(EMQX가 이 주소 아래
# /api/emqx/authn, /api/emqx/authz를 호출) - 채우지 않아도 나머지
# 기능엔 지장 없음, git link 시 웹훅 등록과 EMQX 훅 자동 등록만
# 건너뛴다(뒤엣것이 없으면 MQTT로 직접 붙는 클라이언트는 전부 거부됨 -
# CLI/MCP의 message list/send/wait는 이 값과 무관하게 항상 동작).
#
# 자체 호스팅(Gitea)만 쓸 거면 컨테이너 내부 서비스 이름을 그대로 쓴다
# (docker-compose 네트워크 안에서 gitea → backend로 직접 도달, 호스트
# 포트 경유 불필요): http://backend:8760
# 이 값이 http://localhost:... 등 사설/내부 주소를 가리킬 때만 동작한다는
# 게 실제 Gitea 인스턴스로 검증한 사실이다 - Gitea는 기본적으로 사설
# 네트워크 호스트로의 웹훅 발송을 막는데(docker-compose.yml의 gitea
# 서비스 GITEA__security__ALLOWED_HOST_LIST 참고), 그 허용 목록에 없는
# 임의의 사설 주소는 여전히 막힌다.
#
# 외부 GitHub/GitLab 저장소에도 웹훅을 자동 등록하려면(link-external)
# 그쪽 서버가 실제로 도달 가능한 공인 HTTPS 주소가 따로 필요하다 - 순수
# 로컬/사설 배포에서는 이 경우 자동 등록이 실패하고 수동 설정 안내로
# 폴백한다(정상 동작, git/link-external 응답의 manualWebhookInstructions
# 참고).
PUBLIC_BACKEND_URL=http://backend:8760

# 웹 UI(브라우저)가 EMQX에 MQTT-over-WebSocket으로 직접 붙어 변경 추적
# 뷰/메시징 패널을 실시간 갱신할 때 쓰는 주소 - PUBLIC_BACKEND_URL과 같은
# 이유로 브라우저는 docker 네트워크 밖에 있으니 emqx:8083이 아니라 호스트에
# 노출된 주소가 필요하다(docker-compose.yml의 emqx 서비스 ports 참고).
# 비워두면 웹 UI의 실시간 갱신만 조용히 꺼지고(GET /api/realtime-config가
# null 반환) 나머지 기능엔 지장 없다.
PUBLIC_EMQX_WS_URL=ws://localhost:8083/mqtt

# CLI/MCP가 message wait에서 EMQX에 직접 구독할 때 쓰는 원본 MQTT 주소
# (PUBLIC_EMQX_WS_URL과 같은 이유 - CLI/MCP도 docker 네트워크 밖에서
# 실행되므로 emqx:1883이 아니라 호스트에 노출된 주소가 필요하다,
# docker-compose.yml의 emqx 서비스 ports 참고). 비워두면 message wait이
# 조용히 기존 HTTP 폴링 방식으로 폴백한다(느리지만 계속 동작 - fail-soft).
PUBLIC_EMQX_MQTT_URL=mqtt://localhost:1883

# "GitHub로 로그인" 버튼(외부 저장소 연동 시 저장소 목록에서 직접
# 선택) - GitHub → Settings → Developer settings → OAuth Apps에서
# 새 OAuth App을 만들고, Authorization callback URL에는 **설계자가
# 실제로 이 시스템에 접속하는 주소**에 `/api/git/oauth/github/callback`
# 을 붙여 등록한다(예: http://localhost:8760/api/git/oauth/github/callback
# 또는 실제 배포 도메인). PUBLIC_BACKEND_URL과 달리 이 콜백은 브라우저가
# 직접 리다이렉트되는 흐름이라 사설/로컬 주소여도 항상 문제없이
# 동작한다(웹훅과는 다른 종류의 제약 - README 참고). 두 값을 비워두면
# "GitHub로 로그인" 버튼 자체가 웹 UI에서 안 보인다(fail-soft, URL
# 직접 입력으로 연동하는 기존 방식은 계속 동작).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
