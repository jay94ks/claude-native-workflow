// SP-00001 6절 선택적 서비스 DB - sqlite 변형(별도 DB 서버 없이 "서비스
// DB"를 켜고 싶을 때). schema.mysql.prisma와 모델은 동일, datasource/
// output만 다르다 - sqlite는 @db.Text 어노테이션이 없다(TEXT 타입에
// 길이 제한이 없어 지정할 필요가 없음).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DocComment {
  id         Int     @id @default(autoincrement())
  docPath    String  @map("doc_path")
  body       String
  createdAt  String  @map("created_at")
  resolvedAt String? @map("resolved_at")

  @@map("doc_comments")
}

model DocsIndexEntry {
  id           String  @id
  type         String
  path         String
  title        String
  status       String
  updatedAt    String  @map("updated_at")
  linksJson    String  @map("links_json")
  replyPending Boolean @map("reply_pending")

  @@map("docs_index")
}
