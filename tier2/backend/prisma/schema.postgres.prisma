// SP-00001 6절 선택적 서비스 DB - postgres 변형. schema.mysql.prisma와
// 모델은 동일, datasource/output만 다르다.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocComment {
  id         Int     @id @default(autoincrement())
  projectId  String? @map("project_id")
  docPath    String  @map("doc_path")
  body       String  @db.Text
  createdAt  String  @map("created_at")
  resolvedAt String? @map("resolved_at")

  @@map("doc_comments")
}

model DocsIndexEntry {
  id           String  @id
  type         String
  path         String
  title        String
  status       String
  updatedAt    String  @map("updated_at")
  linksJson    String  @map("links_json")
  replyPending Boolean @map("reply_pending")

  @@map("docs_index")
}

// ---------------------------------------------------------------- SP-00002 (Tier 3)
// schema.mysql.prisma와 모델 동일 - 참고: 그쪽 파일 상단 주석 참고.

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String          @unique
  passwordHash  String          @map("password_hash")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  memberships   ProjectMember[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("refresh_tokens")
}

model Project {
  id         String          @id @default(uuid())
  name       String
  gitRepoUrl String          @map("git_repo_url")
  createdAt  DateTime        @default(now()) @map("created_at")
  members    ProjectMember[]

  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      String
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@id([projectId, userId])
  @@map("project_members")
}
